# Playwright Test Environment Variables
# Copy to .env.test and fill in values (do not commit .env.test)

# Frontend URL (where the TanStack Start dev server runs)
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Backend API URL
API_BASE_URL=http://localhost:3001/api

# Test user credentials (created by global-setup or seeded in backend)
TEST_STAFF_USERNAME=test-staff
TEST_STAFF_PASSWORD=TestPass123!
TEST_PAYROLL_USERNAME=test-payroll
TEST_PAYROLL_PASSWORD=TestPass123!
TEST_ADMIN_USERNAME=test-admin
TEST_ADMIN_PASSWORD=TestPass123!

# Optional: Set to 'true' to run tests in headed mode locally
# PLAYWRIGHT_HEADED=false

# Optional: Slow down test execution for debugging (ms)
# PLAYWRIGHT_SLOWMO=0